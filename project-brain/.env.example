# Database
DATABASE_URL=postgresql://brain_user:brain_password@postgres:5432/project_brain

# Redis
REDIS_URL=redis://redis:6379/0

# Qdrant (Vector DB)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=qdrant_key

# Neo4j (Graph DB - optional)
NEO4J_URL=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# MinIO (Object Storage)
MINIO_URL=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=project-brain
MINIO_SECURE=false

# LM Studio (Local LLM - optional)
LM_STUDIO_URL=http://host.docker.internal:1234
LM_STUDIO_MODEL=lm-studio

# API Configuration
API_TITLE=Project Brain
API_VERSION=0.1.0
SECRET_KEY=dev-secret-key-change-in-production

# Logging
LOG_LEVEL=INFO

# UI
NEXT_PUBLIC_API_URL=http://localhost:8000

# Worker Configuration
WORKERS=4
